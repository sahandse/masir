{
  "version": 8,
  "name": "Masir Offline",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["https://invalid.masir.local/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "#F6F7F4"}
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {"fill-color": "#ECEFE8", "fill-opacity": 0.72}
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {"fill-color": "#DDEDD8", "fill-opacity": 0.9}
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {"fill-color": "#CFE8F6"}
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {"line-color": "#B8DBEF", "line-width": 1.2}
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["path", "track", "service", "minor"], true, false],
      "paint": {"line-color": "#FFFFFF", "line-width": 1.6}
    },
    {
      "id": "roads-main-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
      "paint": {"line-color": "#D6D9D4", "line-width": 4.8}
    },
    {
      "id": "roads-main",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
      "paint": {"line-color": "#FFFFFF", "line-width": 3.4}
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {"fill-color": "#E4E1DC", "fill-outline-color": "#D6D1CB"}
    },
    {
      "id": "road-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 11,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]],
        "text-size": 11
      },
      "paint": {
        "text-color": "#5E625D",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 11, 12, 15]
      },
      "paint": {
        "text-color": "#282B28",
        "text-halo-color": "#F6F7F4",
        "text-halo-width": 1.4
      }
    }
  ]
}
